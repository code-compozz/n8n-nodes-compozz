{
	"name": "n8n-nodes-compozz",
	"version": "1.4.1",
	"description": "n8n community node for Compozz",
	"license": "MIT",
	"homepage": "https://compozz.com",
	"keywords": [
		"n8n-community-node-package",
		"compozz",
		"n8n",
		"workflow",
		"automation",
		"api",
		"integration"
	],
	"author": {
		"name": "Compozz",
		"email": "contact@compozz.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-compozz/n8n-nodes-compozz.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CompozzApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Compozz/Compozz.node.js",
			"dist/nodes/Compozz/CompozzWebhookTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"overrides": {
		"change-case": "4.1.2"
	}
}
